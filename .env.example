# ============================================================================
# GEMINI / AI STUDIO (existing)
# ============================================================================
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="your_app_url_here"

# ============================================================================
# SUPABASE — Public (safe to expose to the client, VITE_ prefix required)
# ============================================================================
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# ============================================================================
# SUPABASE — Server-only (SECRET — never prefix with VITE_, never commit,
# never send to the client). Get this from Supabase Dashboard > Project
# Settings > API > service_role key.
# ============================================================================
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# ============================================================================
# PAYPAL — Server-only secret + public client id
# Get these from https://developer.paypal.com/dashboard/applications
# Use your Sandbox app while testing, then swap to your Live app for
# production (and switch PAYPAL_MODE to "live").
# ============================================================================
PAYPAL_MODE="sandbox"                      # "sandbox" while testing, "live" for real payments
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"

# The client-side PayPal SDK also needs the client id (public, safe to expose)
VITE_PAYPAL_CLIENT_ID="your_paypal_client_id_here"

# Created once via `node scripts/setup-paypal-plans.mjs` (see that script) —
# or manually in the PayPal dashboard under Products & Plans. This is the
# single $4.17/month Premium plan — there is no annual option.
PAYPAL_PLAN_ID_MONTHLY="your_paypal_monthly_plan_id_here"
VITE_PAYPAL_PLAN_ID_MONTHLY="your_paypal_monthly_plan_id_here"

# Create this in the PayPal dashboard under Apps & Credentials > your app >
# Webhooks, pointing at https://YOUR_DEPLOYED_URL/api/paypal/webhook, then
# paste the Webhook ID it gives you here. Required for renewals/cancellations
# to actually update Veda's database.
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"